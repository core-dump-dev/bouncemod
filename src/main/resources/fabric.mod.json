{
  "schemaVersion": 1,
  "id": "bounce-mod",
  "version": "${version}",

  "name": "Bounce Mod",
  "description": "Клиентский мод: все сущности покачиваются в такт музыке.",
  "authors": ["core_dump"],
  "contact": {},

  "license": "MIT",
  "icon": "assets/bounce-mod/icon.png",

  "environment": "client",

