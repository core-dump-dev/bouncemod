{
  "schemaVersion": 1,
  "id": "bounce-mod",
  "version": "${version}",

  "name": "Bounce Mod",
  "description": "Клиентский мод: все сущности покачиваются в такт музыке. Настройки BPM, амплитуды, чередования фазы, громкости и дальности. По мотивам Why's This Dealer / CarbonBounce.",
  "authors": ["core_dump"],
  "contact": {},

  "license": "MIT",
  "icon": "assets/bounce-mod/icon.png",

  "environment": "client",

  "entrypoints": {
    "client": ["core_dump.bouncemod.client.BounceModClient"],
    "modmenu": ["core_dump.bouncemod.client.ModMenuIntegration"]
  },

  "mixins": [
    "bounce-mod.client.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "cloth-config": ">=26.3.159"
  },

  "recommends": {
    "modmenu": ">=21.0.0"
  }
}